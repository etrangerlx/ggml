{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MNIST Training",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/mnist/mnist-train-fc.py",
            "args": ["${workspaceFolder}/examples/mnist/trained_model.gguf"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "mnist-eval",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/Debug/mnist-eval.exe",
            "args": [
                "${workspaceFolder}/examples/mnist/trained_model.gguf", 
            "${workspaceFolder}/data/MNIST/raw/t10k-images-idx3-ubyte",
            "${workspaceFolder}/data/MNIST/raw/t10k-labels-idx1-ubyte"],
            "cwd": "${workspaceFolder}/build/bin/Debug/",
            // "preLaunchTask": "build",  // 先编译，后调试
            // "MIMode": "gdb",
            // "miDebuggerPath": "/usr/bin/gdb"
        },
        {
            "name": "Debug gpt-2-backend",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/Debug/gpt-2-backend.exe",
            "args": ["-m","${workspaceFolder}/models/gpt-2-117M/ggml-model-f16.bin", "-p", "\"This is an example\""],
            "cwd": "${workspaceFolder}/build/bin/Debug/",
            // "preLaunchTask": "build",  // 先编译，后调试
            // "MIMode": "gdb",
            // "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}